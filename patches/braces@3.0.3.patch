diff --git a/lib/validate.js b/lib/validate.js
new file mode 100644
index 0000000000000000000000000000000000000000..53a8ef6daf225cf6d67ec5aa48ab097145b71244
--- /dev/null
+++ b/lib/validate.js
@@ -0,0 +1,20 @@
+'use strict';
+
+// Bound recursive AST walkers, including callers passing an AST directly.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const visited = new Set();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (depth > 128 || visited.has(node) || visited.size >= 65536) {
+      throw new RangeError('Brace pattern nesting exceeds the supported limit');
+    }
+    visited.add(node);
+    if (node.nodes) {
+      if (!Array.isArray(node.nodes) || node.nodes.length > 65536) {
+        throw new RangeError('Brace pattern nesting exceeds the supported limit');
+      }
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
